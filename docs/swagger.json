                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "get recursive path info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
