                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "summary": "get path info",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/paths/all": {
            "post": {
                "description": "returns files and directories recursively starting from the provided path",
