[Unit]
Description=ResticGUI, a web interface for restic backups
Documentation=https://docs.resticgui.com
Wants=network-online.target
After=network-online.target

[Service]
# root, so that backups can read every file; see the docs to run it as
# another user
User=root
WorkingDirectory=/etc/resticgui
ExecStart=/usr/local/bin/resticgui
Restart=on-failure
RestartSec=5
Environment=GIN_MODE=release
# schedules follow this time zone
#Environment=TZ=Europe/Paris
StateDirectory=resticgui
CacheDirectory=resticgui
Environment=RESTIC_CACHE_DIR=/var/cache/resticgui

# Root reads every file it backs up and restores files with their owners;
# these keep it to the rights that needs. Command hooks run under them too:
# widen CapabilityBoundingSet if one needs more.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID
NoNewPrivileges=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
